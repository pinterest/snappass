#: snappass/templates/base.html:2
msgid "en"
msgstr "es"

#: snappass/templates/base.html:4
msgid "Snappass - Share Secrets"
msgstr "Snappass - Compartir secretos"

#: snappass/templates/base.html:10
msgid "Skip to main content"
msgstr "Saltar al contenido principal"

#: snappass/templates/base.html:12
msgid "Main Navigation"
msgstr "Navegación principal"

#: snappass/templates/base.html:14
msgid "SnapPass - Share Secret"
msgstr "SnapPass - Compartir secreto"

#: snappass/templates/confirm.html:6 snappass/templates/set_password.html:39
msgid "Share Secret Link"
msgstr "Compartir enlace secreto"

#: snappass/templates/confirm.html:7
msgid ""
"The secret has been temporarily saved. Send the following URL to your "
"intended recipient."
msgstr ""
"El secreto se ha guardado temporalmente. Envíe la siguiente URL a "
"sudestinatario previsto."

#: snappass/templates/confirm.html:14 snappass/templates/password.html:22
#: snappass/templates/set_password.html:43
msgid "Copy to clipboard"
msgstr "Copiar en el portapapeles"

#: snappass/templates/expired.html:6
msgid "Secret Not Found"
msgstr "Secreto no encontrado"

#: snappass/templates/expired.html:11
msgid ""
"The secret you are looking for has either expired, has already been "
"viewed, or never existed."
msgstr "El secreto que busca ha caducado, ya ha sido visto o nunca existió."

#: snappass/templates/expired.html:16
msgid "Return to SnapPass home"
msgstr "Volver al inicio de SnapPass"

#: snappass/templates/password.html:6 snappass/templates/preview.html:6
msgid "Secret"
msgstr "Secreto"

#: snappass/templates/password.html:7
msgid "Save the following secret to a secure location."
msgstr "Guarda el siguiente secreto en un lugar seguro."

#: snappass/templates/password.html:13
msgid "SnapPass requires a secure context (HTTPS) to decrypt secrets."
msgstr "SnapPass requiere un contexto seguro (HTTPS) para descifrar secretos."

#: snappass/templates/password.html:14
msgid "Missing encryption key in URL fragment. Cannot decrypt secret."
msgstr "Falta la clave de cifrado en la URL. No se puede descifrar el secreto."

#: snappass/templates/password.html:15
msgid ""
"Failed to decrypt the secret. The link may be broken or the key is "
"invalid."
msgstr ""
"No se pudo descifrar el secreto. El enlace puede estar roto o la clave no"
" es válida."

#: snappass/templates/password.html:17
msgid "Decrypted Secret"
msgstr "Secreto descifrado"

#: snappass/templates/password.html:22 snappass/templates/set_password.html:43
msgid "Copied!"
msgstr "¡Copiado!"

#: snappass/templates/password.html:22 snappass/templates/set_password.html:43
msgid "Failed to copy to clipboard."
msgstr "Error al copiar al portapapeles."

#: snappass/templates/password.html:23 snappass/templates/set_password.html:44
msgid "Copy"
msgstr "Copiar"

#: snappass/templates/password.html:29
msgid "Decrypting secret..."
msgstr "Descifrando secreto..."

#: snappass/templates/password.html:32
msgid ""
"The secret has now been permanently deleted from the system, and the URL "
"will no longer work. Refresh this page to verify."
msgstr ""
"El secreto ahora se ha eliminado permanentemente del sistema, y la URL Ya"
" no funcionará. Actualiza esta página para verificarlo."

#: snappass/templates/preview.html:7
msgid ""
"You can only reveal the secret once! After that, it is permanently "
"deleted."
msgstr ""
"¡Solo puedes revelar el secreto una vez! Después de eso, se elimina "
"permanentemente."

#: snappass/templates/preview.html:12
msgid "Reveal secret"
msgstr "Revelar secreto"

#: snappass/templates/set_password.html:6
msgid "Set Secret"
msgstr "Establecer secreto"

#: snappass/templates/set_password.html:7
msgid ""
"SnapPass allows you to share secrets in a secure, ephemeral way. Input a "
"single or multi-line secret, its expiration time, and click Generate URL."
" Share the one-time use URL with your intended recipient."
msgstr ""
"SnapPass te permite compartir secretos de forma segura y efímera. "
"Introduzca un secreto de una o varias líneas, su tiempo de caducidad y "
"haga clic en Generar URL.Comparta la URL de un solo uso con el "
"destinatario previsto\""

#: snappass/templates/set_password.html:12
msgid "Secret Data"
msgstr "Datos secretos"

#: snappass/templates/set_password.html:13
msgid "Enter your secret here..."
msgstr "Ingrese su secreto aquí..."

#: snappass/templates/set_password.html:17
msgid "Expiration Time"
msgstr "Tiempo de expiración"

#: snappass/templates/set_password.html:19
msgid "Two Weeks"
msgstr "Dos semanas"

#: snappass/templates/set_password.html:20
msgid "Week"
msgstr "Semana"

#: snappass/templates/set_password.html:21
msgid "Day"
msgstr "Día"

#: snappass/templates/set_password.html:22
msgid "Hour"
msgstr "Hora"

#: snappass/templates/set_password.html:28
#: snappass/templates/set_password.html:32
msgid "Generate URL"
msgstr "Generar URL"

#: snappass/templates/set_password.html:29
msgid "Generating..."
msgstr "Generando..."

#: snappass/templates/set_password.html:30
msgid ""
"SnapPass requires a secure context (HTTPS) to generate encryption keys "
"securely."
msgstr ""
"SnapPass requiere un contexto seguro (HTTPS) para generar claves de "
"cifrado de forma segura."

#: snappass/templates/set_password.html:31
msgid "An error occurred while encrypting or saving the secret."
msgstr "Se produjo un error al cifrar o guardar el secreto."

#: snappass/templates/set_password.html:40
msgid ""
"The secret has been encrypted and temporarily saved. Send the following "
"URL to your intended recipient."
msgstr ""
"El secreto ha sido cifrado y guardado temporalmente. Envíe la siguiente "
"URL a su destinatario."

#~ msgid "Share Secret"
#~ msgstr "Compartir secretos"

